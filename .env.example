# Optional: copy this file to .env when using docker-compose with env_file.
# Never commit .env containing real credentials.

IMAGE_REPOSITORY=ghcr.io/YOUR_GITHUB_USER/aral-price-monitor
IMAGE_TAG=latest
HOST_PORT=8095
DATA_PATH=./data

TZ=Europe/Berlin
DATABASE_PATH=/data/aral-price-monitor.db
POLL_INTERVAL_SECONDS=300
ANALYSIS_DAYS=30
ARAL_API_URL=https://api.tankstelle.aral.de/api/v3/stations/{station_id}/prices

MQTT_ENABLED=true
MQTT_HOST=YOUR_MQTT_HOST
MQTT_PORT=1883
MQTT_USER=
MQTT_PASSWORD=
MQTT_DISCOVERY_PREFIX=homeassistant
MQTT_BASE_TOPIC=aral_price_monitor

SPRITMONITOR_ENABLED=false
SPRITMONITOR_APP_TOKEN=
SPRITMONITOR_BEARER_TOKEN=
SPRITMONITOR_SYNC_MODE=read_only
SPRITMONITOR_AUTO_SYNC=true
SPRITMONITOR_AUTO_SYNC_SECONDS=86400

TANKERKOENIG_ENABLED=false
TANKERKOENIG_API_KEY=
TANKERKOENIG_LAT=49.000000
TANKERKOENIG_LNG=7.000000
TANKERKOENIG_RADIUS=10
TANKERKOENIG_INTERVAL_SECONDS=600

OSRM_BASE_URL=https://router.project-osrm.org
OSRM_CACHE_HOURS=24
OSRM_ROUTE_CANDIDATES=10

TANK_ASSISTANT_MAX_PRICE_AGE_MIN=60
